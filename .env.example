# Copy this file to .env and fill in your values (never commit .env)

# Square access token — Developer Dashboard > your app > Credentials
# Use the Production token for the live site.
SQUARE_ACCESS_TOKEN=

# "production" or "sandbox"
SQUARE_ENV=production

# Square location ID (Dashboard > Account > Locations). Required for
# online checkout links and for sold-out detection.
SQUARE_LOCATION_ID=

# Port (Render sets this automatically)
PORT=3000
